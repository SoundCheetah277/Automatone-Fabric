  "authors": [
    "leijurv",
    "Brady",
    "Pyrofab"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "LGPL-3.0",
  "icon": "assets/automatone/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": "baritone.Automatone",
